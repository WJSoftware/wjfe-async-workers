{
	"name": "pages",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy-pages": "npm run build && gh-pages -b Pages -d build -t",
