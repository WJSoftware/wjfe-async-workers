		"@types/eslint": "^9.6.0",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.12.4",
		"gh-pages": "^6.1.1",
		"globals": "^17.11.0",
		"svelte": "^5.0.0-next.1",
		"svelte-check": "^4.3.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.0.0",
		"vite": "^8.2.2"
	},
	"type": "module",
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.4",
		"@wjfe/async-workers": "^0.3.0",
