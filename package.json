{
  "name": "@wjfe/async-workers",
  "version": "0.2.4",
  "description": "Provides thread-safe and atomic synchronization objects, and wrappers to easily use web workers with async/await syntax.",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx tsc",
    "postbuild": "publint",
    "deploy-pages": "cd ./pages && npm run deploy-pages",
    "test": "npm run test:unit && npm run test:types",
    "test:unit": "ts-mocha -n loader=ts-node/esm -p ./tsconfig.json --require ./tests/setup.ts ./tests/ut/**/*.test.ts",
    "test:watch": "ts-mocha -n loader=ts-node/esm -p ./tsconfig.json --require ./tests/setup.ts --watch --parallel --slow 100 ./tests/ut/**/*.test.ts",
    "test:types": "tstyche"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WJSoftware/wjfe-async-workers.git"
  },
  "author": {
    "email": "webJose@gmail.com",
    "name": "José Pablo Ramírez Vargas"
  },
  "homepage": "https://wjsoftware.github.io/wjfe-async-workers/",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.5.1",
    "@types/sinon": "^17.0.4",
    "@types/sinon-chai": "^4.0.0",
    "chai": "^6.0.1",
    "publint": "^0.3.12",
    "sinon": "^21.0.0",
    "sinon-chai": "^4.0.1",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "tstyche": "^5.0.0-beta.2",
    "typescript": "^5.5.4",
    "web-worker": "^1.5.0"
  },
  "type": "module"
}
